# Copy to .env.local (ignored). These are configuration values, not credentials.
# Leave the subscription blank to resolve it from your explicitly selected az account.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-epm-dev-eastus
AZURE_ML_WORKSPACE=mlw-epm-dev-eastus
AZURE_ML_COMPUTE=cpu-dev
AZURE_LOCATION=eastus
EPM_AUTH_MODE=azure-cli
# Only needed when using a user-assigned managed identity in a later environment.
AZURE_CLIENT_ID=
